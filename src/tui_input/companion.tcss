Screen {
    layout: vertical;
}

#editor {
    height: 1fr;
    border: round $foreground 30%;
}

#editor:focus {
    border: round $foreground 50%;
}

#statusbar {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

#version {
    width: auto;
}

#stats {
    width: 1fr;
    text-align: right;
}
